FROM olbat/cupsd:stable-2026-07-06

# PAM/NSS LDAP: nslcd bridges PAM and NSS lookups to an AD/LDAP server
# without requiring a full domain join. The SSSD client libraries are kept
# for backward compatibility with the docker-compose.ad.yml overlay.
RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && apt-get install -y --no-install-recommends \
        libnss-sss libpam-sss sssd-common \
        nslcd libnss-ldapd libpam-ldapd \
    && pam-auth-update --package \
    && sed -i -E '/^(passwd|group|shadow):/ { /(^|[[:space:]])sss([[:space:]]|$)/! s/$/ sss/; }' /etc/nsswitch.conf \
    && rm -rf /var/lib/apt/lists/*

COPY config/cupsd.conf /etc/cups/cupsd.conf
COPY scripts/cups-entrypoint.sh /usr/local/bin/cups-entrypoint
COPY scripts/setup-airprint.sh /usr/local/bin/setup-airprint

RUN chmod 0755 /usr/local/bin/cups-entrypoint /usr/local/bin/setup-airprint

ENTRYPOINT ["/usr/local/bin/cups-entrypoint"]
CMD ["/usr/sbin/cupsd", "-f"]
