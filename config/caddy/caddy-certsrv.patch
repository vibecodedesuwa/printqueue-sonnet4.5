 func parseHTMLResponse(response io.Reader) (string, error) {
-	tokenizer := html.NewTokenizer(response)
+	body, err := io.ReadAll(io.LimitReader(response, 2<<20))
+	if err != nil {
+		return "", fmt.Errorf("read AD CS response: %w", err)
+	}
+	tokenizer := html.NewTokenizer(bytes.NewReader(body))
+	var responseText []string
 	for {
 		tt := tokenizer.Next()
 		if tt == html.ErrorToken {
 			break
 		}
+		if tt == html.TextToken && len(responseText) < 40 {
+			text := strings.Join(strings.Fields(string(tokenizer.Text())), " ")
+			if text != "" && !strings.ContainsAny(text, "{}") {
+				responseText = append(responseText, text)
+			}
+		}
 		tag, hasAttr := tokenizer.TagName()
 		if !hasAttr {
 			continue
@@ -39,5 +51,12 @@ func parseHTMLResponse(response io.Reader) (string, error) {
 			}
 		}
 	}
-	return "", errors.New("No valid link found")
+	summary := strings.Join(responseText, " ")
+	if len(summary) > 800 {
+		summary = summary[:800] + "..."
+	}
+	if summary == "" {
+		summary = "empty or unrecognized HTML response"
+	}
+	return "", fmt.Errorf("no valid certificate link found; response text: %s", summary)
 }
