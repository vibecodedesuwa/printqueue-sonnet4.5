# Microsoft AD CS Web Enrollment URL. Use the CA's DNS hostname, not its IP,
# so Kerberos can request the correct HTTP service ticket.
CERTSRV_URL=http://ca.echo.story/certsrv

# Kerberos realm is conventionally uppercase.
CERTSRV_REALM=ECHO.STORY

# Dedicated AD account represented by CERTSRV_KEYTAB_PATH.
CERTSRV_USERNAME=caddy-certsrv
CERTSRV_KEYTAB_PATH=/etc/caddy/certsrv.keytab

# Override this only when the host Kerberos file is incompatible with the
# plugin. The patched PrintQ build reports parsing/opening errors without
# crashing Caddy's certificate worker.
CERTSRV_KRB5_CONFIG=/etc/krb5.conf
