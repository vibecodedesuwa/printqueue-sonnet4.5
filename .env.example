# Flask
SECRET_KEY=change-this-to-a-random-secret

# Authentik SSO
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret
AUTHENTIK_METADATA_URL=https://authentik.your-domain.com/application/o/printq/.well-known/openid-configuration

# Printer (should match the CUPS printer name, run `lpstat -p` to list)
# Change this to your actual printer name!
PRINTER_NAME=HP_Smart_Tank_515

# Admin
ADMIN_GROUPS=admins,print-admins
ADMIN_USERS=admin

# Active Directory / LDAP (set LDAP_ENABLED=true to activate)
# These variables are used by BOTH the web app AND the CUPS IPP auth layer (Docker container or bare-metal PAM)
LDAP_ENABLED=false
LDAP_SHOW_IN_WEBUI=true
LDAP_HOST=ad.domain.local
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_BASE_DN=DC=domain,DC=local
LDAP_BIND_DN=CN=service-account,OU=Services,DC=domain,DC=local
LDAP_BIND_PASSWORD=your-ad-password
LDAP_DOMAIN=domain.local
# Optional but recommended: setup-cups-ldap.sh verifies this account resolves.
LDAP_TEST_USER=
# Required by Debian/Ubuntu nslcd SID-to-UID mapping. PowerShell:
# (Get-ADDomain).DomainSID.Value
LDAP_AD_DOMAIN_SID=
LDAP_USER_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={username}))
# TLS certificate policy for CUPS host LDAP integration: demand, allow, or never.
# Keep "demand" in production. "never" is only for isolated test labs.
LDAP_TLS_REQCERT=demand

# Windows SMB printing with seamless AD authentication. This joins the server
# to AD with Samba/Winbind and creates a separate held CUPS queue.
SAMBA_ENABLED=false
SAMBA_REALM=domain.local
SAMBA_WORKGROUP=DOMAIN
SAMBA_HOSTNAME=printq.domain.local
SAMBA_JOIN_USER=Administrator
SAMBA_SHARE_NAME=PrintQ
SAMBA_WINDOWS_QUEUE=

# Email Print (set MAIL_ENABLED=true to activate)
MAIL_ENABLED=false
MAIL_IMAP_HOST=imap.your-domain.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=print@your-domain.com
MAIL_IMAP_PASS=your-email-password
MAIL_IMAP_FOLDER=INBOX
MAIL_SMTP_HOST=smtp.your-domain.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=print@your-domain.com
MAIL_SMTP_PASS=your-email-password

# CUPS service account (used by the web app to release approved jobs)
CUPS_USER=print
CUPS_PASSWORD=change-this-cups-password

# Claim System
UNCLAIMED_JOB_TIMEOUT=24

# Collabora Online (Office-like A4 editor)
COLLABORA_ENABLED=true
COLLABORA_URL=https://office.toonshou.in
# Optional faster server-to-server discovery endpoint
COLLABORA_INTERNAL_URL=http://172.16.0.9:9980
# Public or LAN URL that the Collabora container can use to reach PrintQ (never localhost)
WOPI_PUBLIC_URL=https://printq.your-domain.com
WOPI_TOKEN_TTL=14400
COLLABORA_VERIFY_TLS=true
OFFICE_FOLDER=data/office
